# Copiez ce fichier en .env et renseignez ce dont vous avez besoin.
# Lancement : node --env-file=.env src/server.mjs
# Pas de guillemets autour des valeurs, pas d'espaces autour du =

ANTHROPIC_API_KEY=sk-ant-api03-...
# Requis si la cle couvre plusieurs espaces de travail (Console, Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=wrkspc_...

# OPENAI_API_KEY=sk-...
# MISTRAL_API_KEY=...
# GEMINI_API_KEY=...
# GROQ_API_KEY=...

# Surcharge des modeles sans toucher a services.json
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# LOCAL_MODEL=llama3.2

PORT=8080
BAUDS=1200
